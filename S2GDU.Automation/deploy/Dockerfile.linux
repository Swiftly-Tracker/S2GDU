FROM debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 libstdc++6 libgcc-s1 libglib2.0-0 libgl1 libx11-6 libxcb1 libxkbcommon0 libfontconfig1 libdbus-1-3 libsm6 libice6 libxrender1 libxcb-cursor0 ca-certificates && rm -rf /var/lib/apt/lists/*
ENV QT_QPA_PLATFORM=offscreen LD_LIBRARY_PATH=/ida
COPY . /app
ENTRYPOINT ["/app/S2GDU"]
